<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive{% if include.limit and site.announcements.scrollable and news_size > 5 %} news-scroll{% endif %}"
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
<script>
  // Show exactly five news rows at a time; the rest scroll.
  (function () {
    function fit() {
      document.querySelectorAll('.news .news-scroll').forEach(function (box) {
        var rows = box.querySelectorAll('tr'), h = 0;
        for (var i = 0; i < Math.min(5, rows.length); i++) h += rows[i].getBoundingClientRect().height;
        box.style.maxHeight = Math.ceil(h) + 'px';
        box.style.overflowY = 'auto';
      });
    }
    window.addEventListener('load', fit);
    window.addEventListener('resize', fit);
    fit();
  })();
</script>
